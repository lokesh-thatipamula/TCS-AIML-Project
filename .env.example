# =================================================================
# Insurance Automated Risk Profile Summarizer - LLM Configuration
# =================================================================

# Active Provider: "local", "gemini", "openai", "anthropic", "ollama", "custom"
# Default is "local" (zero-dependency deterministic engine, ultra-fast & private)
LLM_PROVIDER=local

# 1. Google Gemini Configuration
# Get key: https://aistudio.google.com/
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# 2. OpenAI Configuration
# Get key: https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# 3. Anthropic Claude Configuration
# Get key: https://console.anthropic.com/
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# 4. Local Ollama Configuration (100% Offline Open-Source LLMs)
# Download: https://ollama.ai/ (e.g., ollama run llama3)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# 5. Custom OpenAI-Compatible Endpoints (Groq, Together AI, vLLM, DeepSeek, LM Studio)
# Example Groq: https://api.groq.com/openai/v1
# Example LM Studio: http://localhost:1234/v1
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=default
